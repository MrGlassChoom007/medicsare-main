---
import { withBase } from "@lib/urls";
import siteConfig from "../../siteConfig";
import Container from "@ui/Container.astro";
import Logo from "@ui/Logo.astro";

const footerLinks = [...siteConfig.nav.info, ...siteConfig.nav.support];
---

<footer class="footer">
	<Container class="container--footer">
		<div class="footer-col footer-col--logo">
			<Logo />
			<p class="footer__text">
				
			</p>
		</div>

		<nav class="footer-nav" aria-label="Footer">
			<ul class="footer-list">
				{footerLinks.map((item) => (
					<li class="footer-list__item">
						<a href={withBase(item.url)} class="footer-list__link">
							{item.text}
						</a>
					</li>
				))}
			</ul>
		</nav>

		{
			siteConfig.copyright && (
				<div class="footer-bottom">
					<p>{siteConfig.copyright}</p>
				</div>
			)
		}
	</Container>
</footer>

<style>
	.footer {
		padding: 10rem var(--section-padding-inline) 2.4rem;
		background-color: #9917008f;

		@media screen and (max-width: 1024px) {
			padding-block: 4rem;
		}

		.logo {
			z-index: 0;
		}
	}

	.footer__text {
		line-height: 1.66;
	}

	.footer-col {
		--gap: 2.4rem;
		display: flex;
		flex: 0 1 calc(22% - var(--gap));
		flex-direction: column;
		gap: var(--gap);

		@media screen and (max-width: 1024px) {
			flex-basis: calc(33.33% - var(--gap));
		}

		&.footer-col--logo {
			padding: 0 4rem 0 0;
			flex: 0 1 calc(33.33% - var(--gap));

			@media screen and (max-width: 1024px) {
				padding: 0;
				flex-basis: 100%;
			}
		}
	}

	.footer-nav {
		flex: 1 0 100%;
	}

	.footer-list {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.6rem 3.2rem;
	}

	.footer-list__link {
		color: var(--color-text);
		font-weight: 600;
		text-decoration: none;

		&:hover {
			text-decoration: underline;
		}
	}

	.footer-bottom {
		width: 100%;
		padding-top: 2.4rem;
		border-top: 1px solid #000000;
	}
</style>
